{
    "name": "MCM Tree",
    
    "description": "View Branching in MCM",
    
    "version": "1.0.2",
    
    "manifest_version": 3,
    
    "icons": {
        "16": "images/MCM_Tree-16.png",
        "32": "images/MCM_Tree-32.png",
        "48": "images/MCM_Tree-48.png",
        "128": "images/MCM_Tree-128.png"
    },
   
    "action": {
        "default_popup": "hello.html",
        "default_icon": {
            "16": "images/MCM_Tree-16.png",
            "32": "images/MCM_Tree-32.png",
            "48": "images/MCM_Tree-48.png"
        }
    },

    "host_permissions": [
        "https://www.mcm.york.ac.uk/*",
        "https://mcm.york.ac.uk/*"
    ],

    "content_scripts": [{
        "js": ["scripts/content.js"],
        "matches": [
            "https://www.mcm.york.ac.uk/MCM/species/*",
            "https://mcm.york.ac.uk/MCM/species/*"
        ]
    }]
}